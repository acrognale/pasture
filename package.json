{
  "name": "pasture-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Pasture monorepo - desktop GUI and web UI for Codex",
  "keywords": [],
  "license": "Apache-2.0",
  "author": {
    "name": "Anthony Crognale",
    "email": "anthony@acrognale.com"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "copy:app": "pnpm run copy:app --workspace=apps/desktop",
    "dev": "turbo dev --filter=@pasture/desktop",
    "dev:web": "turbo dev --filter=@pasture/web",
    "format:check": "turbo format:check",
    "format:fix": "turbo format:fix",
    "format:rust": "cargo fmt --all -- --config imports_granularity=Item",
    "generate:types": "npm run generate:types --workspace=apps/desktop",
    "lint": "turbo lint",
    "package": "npm run package --workspace=apps/desktop",
    "prepare": "husky",
    "storybook": "npm run storybook --workspace=apps/desktop",
    "test": "turbo test",
    "sherif": "sherif",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "test:watch": "npm run test:watch --workspace=apps/desktop",
    "typecheck": "turbo typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-no-barrel-files": "^1.2.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-storybook": "10.0.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.4",
    "prettier": "^3.6.2",
    "prettier-plugin-packagejson": "^2.5.19",
    "sherif": "^1.9.0",
    "turbo": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22"
  }
}
