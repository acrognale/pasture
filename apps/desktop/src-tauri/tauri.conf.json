{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Pasture",
  "version": "0.5.1",
  "identifier": "com.acrognale.pasture",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxMEE5MTM4RUYxMTFERDcKUldUWEhSSHZPSkVLd1Zlc0hVWHJIK0lmeTMrbTZ3WmdlTFhWNGlNQyt4SlZndERhaXRwSzR4RWEK",
      "endpoints": [
        "https://github.com/acrognale/pasture/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run vite:dev -w @pasture/desktop",
    "beforeBuildCommand": "npm run vite:build"
  },
  "app": {
    "windows": [
      {
        "title": "Pasture",
        "width": 1100,
        "height": 720,
        "minWidth": 950,
        "minHeight": 800,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#fcfcfc",
        "transparent": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "capabilities": [
        {
          "identifier": "draggable-window",
          "windows": [
            "*"
          ],
          "permissions": [
            "core:window:allow-start-dragging"
          ]
        },
        {
          "identifier": "codex-events",
          "windows": [
            "*"
          ],
          "permissions": [
            {
              "identifier": "core:event:allow-listen",
              "options": {
                "events": [
                  "codex-event",
                  "codex:window:contextUpdated",
                  "update:check-requested"
                ]
              }
            },
            {
              "identifier": "core:event:allow-unlisten",
              "options": {
                "events": [
                  "codex-event",
                  "codex:window:contextUpdated",
                  "update:check-requested"
                ]
              }
            }
          ]
        },
        {
          "identifier": "window-control",
          "windows": [
            "*"
          ],
          "permissions": [
            "core:window:allow-close"
          ]
        },
        {
          "identifier": "updater",
          "windows": [
            "*"
          ],
          "permissions": [
            "updater:default"
          ]
        },
        {
          "identifier": "process",
          "windows": [
            "*"
          ],
          "permissions": [
            "process:allow-restart"
          ]
        },
        {
          "identifier": "clipboard-manager",
          "windows": [
            "*"
          ],
          "permissions": [
            "clipboard-manager:allow-write-text"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
