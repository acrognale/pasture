{
  "extends": "../../packages/configs/tsconfig.react.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "~/*": ["./src/*"]
    },
    "outDir": "dist",
    "types": ["vite/client", "node"],
    "sourceMap": true,
    "noImplicitAny": true,
    "strictNullChecks": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.*.ts", "vitest.config.ts", ".storybook/*.ts", ".storybook/*.tsx"]
}
