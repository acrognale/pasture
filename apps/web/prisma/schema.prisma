generator client {
  provider   = "prisma-client"
  engineType = "client"
  output     = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SharedThread {
  id         String   @id @default(cuid())
  createdAt  DateTime @default(now())
  title      String?
  model      String?
  transcript Json
}
